# Copy to .env.local and fill in. Never commit .env.local.

# Mailgun (same key as gtcfx.com). Without it the welcome e-mail is not sent.
MAILGUN_API_KEY=
# Optional overrides (defaults shown)
# MAILGUN_DOMAIN=mx.gtcmail.com
# MAILGUN_FROM=GTCFX <portal@mx.gtcmail.com>
# MAILGUN_USERNAME=api
# MAILGUN_API_URL=https://api.mailgun.net

# CRM portal API base URL (default shown)
# GTC_PORTAL_API=https://web.mygtc.app/api/pub

# Public site URL: enables canonical, hreflang and Open Graph URLs (no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://expo.example.com

# Country preselection: the host's geo header is used first (Vercel, Cloudflare, CloudFront); without one the visitor's IP
# is looked up at ipwho.is. Set to off to never send visitor IPs to that service.
# GEOIP_LOOKUP=off
